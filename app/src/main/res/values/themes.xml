<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CampusRoster" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="colorPrimaryDark">@color/navy_primary_dark</item>
        <item name="colorAccent">@color/accent_red</item>
        <item name="android:windowBackground">@color/background_grey</item>
        <item name="android:statusBarColor">@color/navy_primary</item>
    </style>

    <style name="Widget.CampusRoster.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/navy_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">#CCD6EE</item>
    </style>

    <style name="Widget.CampusRoster.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/navy_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.CampusRoster.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/navy_primary</item>
        <item name="hintTextColor">@color/navy_primary</item>
    </style>

    <style name="TextAppearance.CampusRoster.StatNumber" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_red</item>
    </style>

    <style name="TextAppearance.CampusRoster.StatLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>